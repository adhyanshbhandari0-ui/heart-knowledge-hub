title: "California IHSS Individual Provider County Wage Rates 2026"
version: "2026.2"
date-released: 2026-11-11
type: dataset
authors:
  - name: "California Care Compass"
url: "https://californiacarecompass.com/data/california-ihss-county-wages-2026"
